# Copy to .env to override. Every value has the same default in docker-compose.yml,
# so `docker compose up` works without a .env file. All credentials are DEV-ONLY.

# --- Host ports and binding ---------------------------------------------------
# web and api listen on BIND_ADDR; set 0.0.0.0 to reach them from other devices.
BIND_ADDR=127.0.0.1
WEB_PORT=3000
API_PORT=8000
DB_PORT=5433
LOGS_PORT=8080
# Host name printed in the startup banner
PUBLIC_HOST=localhost

# --- Postgres (dev-only credentials) ------------------------------------------
POSTGRES_PASSWORD=postgres_dev_pw
EOS_OWNER_PASSWORD=eos_owner_dev_pw
EOS_APP_PASSWORD=eos_app_dev_pw
EOS_READONLY_PASSWORD=eos_readonly_dev_pw

# --- App ----------------------------------------------------------------------
APP_ENV=development
# Business "now" (the seed's now). Ticking mode advances from here in real time.
APP_NOW=2026-11-11T15:00:00Z
# The rules report always uses APP_NOW as a frozen "now" and its own scratch database:
#   docker compose --progress quiet run --rm --build rules-report      (make rules-report rewrites rules_report.json)
APP_CLOCK_MODE=ticking
# Session cookie signing key (dev-only; the API refuses this value when APP_ENV=production)
SESSION_SECRET=dev-only-session-secret-change-me-0000000000000000
# Origin the browser uses for the web app (CSRF Origin check)
WEB_ORIGIN=http://localhost:3000

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
# Log request and response bodies (up to 8 KB, secrets redacted). Dev-only.
LOG_PAYLOADS=true
# Peers allowed to set X-Request-ID / X-Forwarded-For (the Next.js server)
TRUSTED_PROXY_HOSTS=web

# --- Scaling (platform layers L1/L2 raise these) ------------------------------
API_WORKERS=1
