# Copy to .env to override. Every value has the same default in docker-compose.yml,
# so `docker compose up` works without a .env file. All credentials are DEV-ONLY.

# --- Host ports and binding ---------------------------------------------------
# web and api listen on BIND_ADDR; set 0.0.0.0 to reach them from other devices.
BIND_ADDR=127.0.0.1
WEB_PORT=3000
API_PORT=8000
DB_PORT=5433
LOGS_PORT=8080
REDIS_PORT=6379
# Host name printed in the startup banner
PUBLIC_HOST=localhost

# --- Postgres (dev-only credentials) ------------------------------------------
POSTGRES_PASSWORD=postgres_dev_pw
EOS_OWNER_PASSWORD=eos_owner_dev_pw
EOS_APP_PASSWORD=eos_app_dev_pw
EOS_READONLY_PASSWORD=eos_readonly_dev_pw
# Redis (layer L3): the cache only accepts the API and the seed
REDIS_PASSWORD=redis_dev_pw

# --- App ----------------------------------------------------------------------
APP_ENV=development
# Business "now" (the seed's now). Ticking mode advances from here in real time.
APP_NOW=2026-11-11T15:00:00Z
# The rules report always uses APP_NOW as a frozen "now" and its own scratch database:
#   docker compose --progress quiet run --rm --build rules-report      (make rules-report rewrites rules_report.json)
APP_CLOCK_MODE=ticking
# Session cookie signing key (dev-only; the API refuses this value when APP_ENV=production)
SESSION_SECRET=dev-only-session-secret-change-me-0000000000000000
# Browser origins allowed to write (CSRF Origin check), comma-separated. Leave unset: it
# defaults to http://localhost:WEB_PORT and http://PUBLIC_HOST:WEB_PORT, which follows
# port and LAN changes. Set it only if people open the app at some other URL.
# WEB_ORIGIN=http://localhost:3000

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=info
# Log request and response bodies (up to 8 KB, secrets redacted). Dev-only.
LOG_PAYLOADS=true
# Peers allowed to set X-Request-ID / X-Forwarded-For (the Next.js server)
TRUSTED_PROXY_HOSTS=web

# --- Scaling (platform layers L1 and L2) -------------------------------------
# Uvicorn processes sharing the API port; 1 switches layer L1 off.
API_WORKERS=2
# How the web server runs: pm2 (PM2 cluster mode, WEB_INSTANCES workers, or "max" for
# one per CPU thread) or node (one plain process: layer L2 off).
WEB_RUNNER=pm2
WEB_INSTANCES=2

# --- Cache (platform layer L3) -----------------------------------------------
# Redis cache-aside reads; false sends every read to Postgres. Postgres stays the only
# source of truth either way, so the results are the same.
CACHE_ENABLED=true
# Seconds: team read models (also replaced by every team write) and reference data
# (also replaced by every seed).
CACHE_TTL_TEAM=600
CACHE_TTL_REF=3600

# --- Security extras (platform layer L4) ------------------------------------
# Per-request nonce Content-Security-Policy on every page (frontend/src/proxy.ts); off: none
# (the basic headers stay).
CSP_MODE=nonce
# Redis rate limits on writes: 10 logins a minute per address, 30 Make it an Issue and 120
# other writes a minute per user. false: no limits.
RATE_LIMIT_ENABLED=true
# Read-only root filesystem for the app containers (a small writable /tmp); false keeps it
# writable, for debugging inside a container.
READ_ONLY_FS=true

# --- Observability extras (platform layer L5) --------------------------------
# `worker` (the process id) on every API log line, and PM2's JSON lines (with the worker
# id) for the web app; true or false.
LOG_WORKER_TAGS=true
# Warn in the logs when a database connection stays checked out over 5 s.
POOL_LEAK_WATCH=true
# Gzip API responses of 1 KB and more (never the live event stream).
GZIP_ENABLED=true
